        private void createAccountBtn_Click(object sender, EventArgs e)
        {
            string username = textBox1.Text.Trim();
            string password = textBox2.Text.Trim();
            
            // Validate input
            if (string.IsNullOrEmpty(username) || string.IsNullOrEmpty(password) )
            {
                label6.Text = "Please fill in all fields.";
                return;
            }

         

            // Create directory if it doesn't exist
            string folderPath = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.ApplicationData), "TaskScheduler");
            Directory.CreateDirectory(folderPath);

            string filePath = Path.Combine(folderPath, "UserData.csv");

            // Check if username already exists
            if (File.Exists(filePath))
            {
                string[] lines = File.ReadAllLines(filePath);
                foreach (string line in lines)
                {
                    string[] parts = line.Split(',');
                    if (parts.Length > 0 && parts[0] == username)
                    {
                        label6.Text = "Username already exists.";
                        return;
                    }
                }
            }

            // Save new user
            using (StreamWriter sw = File.AppendText(filePath))
            {
                sw.WriteLine($"{username},{password}");
                if (sw == null)
                {
                    label6.Text = "Error saving user data.";
                    return;
                }
            }

            MessageBox.Show("Account created successfully!", "Success", MessageBoxButtons.OK, MessageBoxIcon.Information);

            // Redirect to SignIn page
            Signin signInForm = new Signin();
            signInForm.Show();
            this.Hide();
        }
